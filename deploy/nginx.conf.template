# Waffle Story — Nginx site. setup.sh fills in __DOMAIN__.
# Certbot adds the HTTPS (443) block and the HTTP→HTTPS redirect.

upstream waffle_story {
    server 127.0.0.1:__PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    client_max_body_size 10m;   # fridge-wall uploads (8 MB limit in the form)

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # hashed build assets never change: cache for a year
    location /_next/static/ {
        proxy_pass http://waffle_story;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # brand art and textures: cache for a week
    location ~* ^/(art|textures)/ {
        proxy_pass http://waffle_story;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        proxy_pass http://waffle_story;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
